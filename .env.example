# These are the starting values. Most can also be changed on the dashboard
# (Settings button), which saves to data/settings.json and wins over this file.
# One or more groups, separated by commas (or edit the list in Settings)
GROUPS=https://www.facebook.com/groups/your-group-name
SCRAPE_ALL_GROUPS=false
GROUP_PAUSE_MIN=3
SORT_CHRONOLOGICAL=true
MAX_POSTS=100
AUTO_SCROLL_LIMIT=true
SCROLL_LIMIT=40
MAX_IDLE_SCROLLS=4
MIN_DELAY=2
MAX_DELAY=7
HEADLESS=false
BLOCK_MEDIA=true
FAST_FORWARD=true
SKIP_SEE_MORE_SAVED=true
BATCH_MODE=false
BATCH_POSTS=30
BATCH_TOTAL=150
BATCH_REST_MIN=120
RECYCLE_MB=1200
COLLECT_COMMENTS=true
MAX_COMMENTS_PER_POST=3
EXPAND_COMMENTS=true
COLLECT_REACTIONS=true
EXPAND_REACTIONS=true
LOW_RISK_MODE=false
CHECKPOINT_ALERT=true
UPDATE_SAVED=false
UPDATE_SAVED_CLICKS=false
ANONYMIZE=true
# Demand / Opportunities tab. Edit these in the dashboard's Settings tab for
# easier editing; values here are read only when the dashboard has no saved
# value. Separate terms with commas or newlines. Spaces inside a term are kept.
OPPORTUNITY_DAYS=30
# FOCUS_KEYWORDS=len,sợi,milk,milk cotton,cotton,nhung,nhung gấu,chenille,baby,sữa,lông cừu,loang,kim móc
# DEMAND_KEYWORDS=cần,mua,tìm,cần mua,tìm địa chỉ,mua ở đâu,looking for
# STRONG_DEMAND_KEYWORDS=tìm len,mua len,tìm sợi,mua sợi,tìm địa chỉ,shop nào
# SUPPLY_KEYWORDS=bán,pass,thanh lý,sỉ,giá sỉ,sẵn,shop
# SELLER_BLOCKERS=pass,thanh lý,xả kho,sẵn,shop,ib,nhắn tin,sale
# DEMAND_REQUIRES_FOCUS=true
# IGNORE_KEYWORDS=tuyển dụng,việc làm,lens,kính
# Automatic website promotion on high-intent buyer posts. Off by default:
# commenting automatically can get the Facebook account limited or banned.
# AUTO_REPLY=false
# AUTO_REPLY_DAILY_LIMIT=5
# AUTO_REPLY_MIN_MINUTES=3
# AUTO_REPLY_MAX_MINUTES=8
# AUTO_REPLY_DAYS=7
# AUTO_REPLY_MAX_FAILURES=2
# AUTO_REPLY_SITE_URL=https://handmade.wandalink.com/
# Secret that makes hashed author names irreversible. install.py / start.py
# replace this with a random value when they create your .env. Keep it private
# and don't change it after you've started collecting.
HASH_SALT=pick-any-random-string
# Optional
# DATA_DIR=data
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8765
# Extra Host names allowed to open the dashboard, for LAN use only. Comma
# separated, with the port (e.g. 192.168.1.20:8765). Leave empty for localhost.
# DASHBOARD_ALLOWED_HOSTS=
# For servers/Docker only: lets the vault unlock without a prompt.
# Prefer passing it at run time (docker run -e) over writing it here.
# SCRAPER_PASSPHRASE=
# Browser: empty = auto (Playwright Chromium, then Chrome, then Edge), or chromium / chrome / msedge
# BROWSER_CHANNEL=
